---
const pathname = Astro.url.pathname;

const linkClasses = (href: string) =>
	`rounded-full px-4 py-2 text-sm font-medium transition ${pathname === href ? "bg-cyan-500 text-slate-950" : "text-slate-300 hover:bg-slate-800 hover:text-slate-50"}`;
---

<header class="border-b border-slate-800 bg-slate-950/90 backdrop-blur">
	<div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-6 py-4 sm:px-8 lg:px-10">
		<a href="/" class="text-lg font-semibold tracking-tight text-slate-50">
			Product Manager
		</a>

		<nav class="flex items-center gap-2">
			<a href="/" class={linkClasses("/")}>Home</a>
			<a href="/about" class={linkClasses("/about")}>About</a>
		</nav>
	</div>
</header>